<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{page_shell.site_name}}</title>
  {% for link in page_shell.link_includes %}
  <link href="{{link.src}}" rel="stylesheet" integrity="{{link.integrity}}" />
  {% endfor %}
  {% for js_script in page_shell.script_includes %}
  <script src="{{js_script.src}}" integrity="{{js_script.integrity}}"></script>
  {% endfor %}
</head>

<body>
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">{{page_shell.site_name}}</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/">Home</a>
          </li>

          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/add-torrent">Add Torrent</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/user-management">User Management</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/sign-out">Sign Out</a>
          </li>
          <li class="nav-item">
            <a class="nav-link disabled" aria-disabled="true">
            {{page_shell.username}}
            </a>
          </li>
        </ul>
      </div>
      </div>
  </nav>
  <div class="container">
    <div class="row">
      <div class="col">
        {% block left_content %}
          
        {% endblock %}
      </div>
      <div class="col" id="right-col">
        {% block right_content %}
        {% endblock %}
      </div>
    </div>
  </div>

</body>

</html>